@using CARGO.Web.ViewModels.CARGO_D06
@model CARGO_D06IndexViewModel
<h1 class="section-h">一般用車申請作業 · 司機任務單（駕駛）</h1>
<p class="intro">查詢運輸主管同意後的用車任務，一列為一位司機的一段指派區間；雙駕駛各自一列，自駕區間列為「自駕」。點「細節」檢視任務資訊與隨行貨物。@(ViewBag.IsBusiness==true?"目前為業務總覽。":"目前僅顯示你的指派區間。")</p>
@using(Html.BeginForm("Index","CARGO_D06",FormMethod.Get)) {
<section class="card"><div class="card-title"><span>查詢條件</span><button type="submit" class="btn btn-primary btn-sm">🔍 查詢</button></div>
<div class="fields">
<label class="query-field"><span>日期起</span>@Html.TextBoxFor(x=>x.FromDate,"{0:yyyy-MM-dd}",new {type="date"})</label>
<label class="query-field"><span>日期迄</span>@Html.TextBoxFor(x=>x.ToDate,"{0:yyyy-MM-dd}",new {type="date"})</label>
<label class="query-field"><span>司機</span>@Html.DropDownListFor(x=>x.DriverId,Model.Drivers,"全部（可檢視範圍）")</label>
</div><p class="intro">顯示指派區間與查詢日期重疊的任務，包含日期迄當天；日期留空表示不限。</p>
@Html.ValidationSummary(false,"",new {role="alert"})
</section>
}
<section class="card"><div class="card-title"><span>司機任務</span><span>@Model.Tasks.Count 筆</span></div>
@if(ViewData.ModelState.IsValid && Model.Tasks.Count==0){<div class="empty">目前查詢條件下沒有可顯示的任務。派車須先通過簽審；駕駛帳號也須完成司機代碼對應。</div>}
@if(Model.Tasks.Count>0){
<div class="table-scroll"><table class="detail-table"><thead><tr><th>操作</th><th>日期</th><th>出發時間</th><th>司機名稱</th></tr></thead><tbody>
@foreach(var t in Model.Tasks.OrderBy(x=>x.From).ThenBy(x=>x.DriverName).ThenBy(x=>x.RequestId)){
<tr><td><a class="btn btn-ghost btn-sm" href="@Url.Action("Detail",new {id=t.RequestId,start=t.From.Ticks,driver=t.DriverId,FromDate=Model.FromDate.HasValue?Model.FromDate.Value.ToString("yyyy-MM-dd"):"",ToDate=Model.ToDate.HasValue?Model.ToDate.Value.ToString("yyyy-MM-dd"):"",DriverId=Model.DriverId})">細節</a></td><td>@t.From.ToString("yyyy-MM-dd")</td><td>@t.From.ToString("HH:mm")</td><td>@t.DriverName</td></tr>
}
</tbody></table></div>}
</section>
