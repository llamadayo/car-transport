@using CARGO.Web.ViewModels.CARGO_D02
@using CARGO.Web.Models
@using Kendo.Mvc.UI
@model CARGO_D02IndexViewModel
@{ string controller = "CARGO_D02";
   var statuses = new Dictionary<string,string> { {"submitted","待二級審"}, {"rejected","退回修編"}, {"passed","已核准"} };
}

<h1 class="section-h">@ViewBag.Title</h1>
<p class="intro">審核所屬申請人的一般用車申請。核准後交由業務派車；退回修編請填寫意見。</p>
<section class="card"><div class="card-title"><span>查詢條件</span><button type="button" class="btn btn-primary btn-sm" id="search">🔍 查詢</button></div>
<form id="query-form">@Html.AntiForgeryToken()<div class="fields">
<label class="query-field"><span>申請人（模糊）</span>@Html.TextBoxFor(x => x.Applicant, new { placeholder="輸入姓名關鍵字" })</label>
<label class="query-field"><span>用車日期</span> @Html.TextBoxFor(x => x.UseDate, "{0:yyyy-MM-dd}", new { type="date" })</label>
<label class="query-field"><span>狀態</span> @Html.DropDownListFor(x => x.Status, new SelectList(statuses,"Key","Value"), "全部狀態")</label>
</div></form></section>
<section class="card"><div class="card-title"><span>待審與歷史申請 <span id="result-count" class="result-count"></span></span>
<button id="batch" type="button" class="btn btn-accent btn-sm">✓ 本頁待審全部同意</button>

</div>
<p id="grid-error" role="alert" hidden></p>
<script>
function workQuery() { return { __RequestVerificationToken: jQuery('#query-form input[name=__RequestVerificationToken]').val(), Applicant: jQuery('#Applicant').val(), UseDate: jQuery('#UseDate').val(), Status: jQuery('#Status').val() }; }
function workBound(e) { jQuery('#result-count').text(e.sender.dataSource.total() + ' 筆'); }
function workError(e) { jQuery('#grid-error').text(e.errors || '查詢失敗，請確認登入狀態與資料庫設定。').prop('hidden',false).show(); }
function workBadge(value) { var cls = /退回/.test(value) ? 'b-red' : /審/.test(value) ? 'b-amber' : /同意|出車/.test(value) ? 'b-green' : 'b-navy'; return '<span class="badge ' + cls + '">' + kendo.htmlEncode(value) + '</span>'; }
</script>
@(Html.Kendo().Grid<CARGO_D02RowViewModel>().Name("workGrid").Columns(c => {
 c.Bound(x => x.RequestId).Title("操作").ClientTemplate("<a class='btn btn-ghost btn-sm grid-detail-link' href='" + Url.Action("Detail",controller) + "/#= RequestId #' title='查看明細' aria-label='查看明細：#: RequestNo #'><img src='" + Url.Content("~/Content/vendor/fontawesome/newspaper.svg") + "' width='18' height='18' alt='' aria-hidden='true' /></a>").Width(85);
 c.Bound(x => x.RequestNo).Title("申請單號").ClientTemplate("<strong class='request-no'>#: RequestNo #</strong>").Width(125);
 c.Bound(x => x.Category).Title("類別").ClientTemplate("<span class='badge b-navy'>#: Category #</span>").Width(110);
 c.Bound(x => x.Applicant).Title("申請人").Width(120);
 c.Bound(x => x.Approver).Title("簽核主管").Width(140);
 c.Bound(x => x.StartAt).Title("用車時段").ClientTemplate("#: kendo.toString(StartAt, 'yyyy-MM-dd HH:mm') #<br>～ #: kendo.toString(EndAt, 'yyyy-MM-dd HH:mm') #").Width(195);
 c.Bound(x => x.Passengers).Title("人數").Width(75);
 c.Bound(x => x.SelfDrive).Title("自駕").Width(75);
 c.Bound(x => x.Cargo).Title("隨行貨物").ClientTemplate("#: Cargo ## if (HazardousCargo) { # <span class='badge b-red'>⚠ 危險品</span># } #").Width(160);
 c.Bound(x => x.Status).Title("狀態").ClientTemplate("#= workBadge(Status) #").Width(115);

}).Pageable(p => p.PageSizes(new[] {20,50,100})).Scrollable(s => s.Height("auto")).Events(e => e.DataBound("workBound"))
.DataSource(ds => ds.Ajax().PageSize(20).ServerOperation(true).Read(r => r.Action("Read",controller).Type(HttpVerbs.Post).Data("workQuery")).Events(e => e.Error("workError"))))
</section>
@using (Html.BeginForm("Batch",controller,FormMethod.Post,new { id="batch-form" })) { @Html.AntiForgeryToken()<div id="batch-items"></div> }
@section scripts { <script src="@Url.Content("~/Scripts/cargo-workflow.js")?v=20261011-validation"></script> }
