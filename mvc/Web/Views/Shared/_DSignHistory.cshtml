@using CARGO.Web.ViewModels.Shared
@model List<CARGO_DSignViewModel>
@if (Model.Count > 0) {
<section class="card"><h2 class="card-title">派車簽審歷程</h2><div class="table-scroll"><table class="detail-table"><thead><tr><th>輪次</th><th>送簽時間／人員</th><th>指派摘要</th><th>結果</th><th>簽審人員／時間</th><th>意見</th></tr></thead><tbody>
@foreach (var sign in Model) { <tr><td>@sign.Round</td><td>@sign.SubmittedAt.ToString("yyyy-MM-dd HH:mm")<br />@sign.SubmittedBy</td><td>@sign.Summary</td><td>@sign.Status</td><td>@sign.DecidedBy @(sign.DecidedAt.HasValue ? sign.DecidedAt.Value.ToString("yyyy-MM-dd HH:mm") : "")</td><td>@sign.Note</td></tr> }
</tbody></table></div></section>
}
