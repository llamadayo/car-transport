@using System.Linq
@using CARGO.Web.ViewModels.CARGO_D01
@model CARGO_D01FormViewModel
<div class="table-scroll"><table class="editor-table"><thead><tr><th>品名</th><th>長 cm</th><th>寬 cm</th><th>高 cm</th><th>重量 kg</th><th>件數</th><th>品類</th><th>外包裝</th><th>危險品</th><th>操作</th></tr></thead>
<tbody id="rows-Cargo">
@for (var i = 0; i < Model.Cargo.Count; i++)
{
    <tr><td>@Html.TextBox("Cargo[" + i + "].Name", Model.Cargo[i].Name, new { type = "text", maxlength = "200", aria_label = "品名" })</td><td>@Html.TextBox("Cargo[" + i + "].Length", Model.Cargo[i].Length, new { type = "number", step = "0.001", min = "0.001", aria_label = "長 cm" })</td><td>@Html.TextBox("Cargo[" + i + "].Width", Model.Cargo[i].Width, new { type = "number", step = "0.001", min = "0.001", aria_label = "寬 cm" })</td><td>@Html.TextBox("Cargo[" + i + "].Height", Model.Cargo[i].Height, new { type = "number", step = "0.001", min = "0.001", aria_label = "高 cm" })</td><td>@Html.TextBox("Cargo[" + i + "].Weight", Model.Cargo[i].Weight, new { type = "number", step = "0.001", min = "0", aria_label = "重量 kg" })</td><td>@Html.TextBox("Cargo[" + i + "].Quantity", Model.Cargo[i].Quantity, new { type = "number", step = "1", min = "1", aria_label = "件數" })</td><td>@Html.DropDownList("Cargo[" + i + "].Category", new SelectList(Model.Options.Where(x => x.Type == "CARGO_CATEGORY"), "Code", "Label", Model.Cargo[i].Category), "請選擇")</td><td>@Html.TextBox("Cargo[" + i + "].Packaging", Model.Cargo[i].Packaging, new { type = "text", maxlength = "200", aria_label = "外包裝" })</td><td>@Html.CheckBox("Cargo[" + i + "].Hazardous", Model.Cargo[i].Hazardous)</td><td><button type="button" data-remove>刪除</button></td></tr>
}
</tbody></table></div>
<template id="template-Cargo"><tr><td><input name="Cargo[__index__].Name" type="text" maxlength="200" aria-label="品名" /></td><td><input name="Cargo[__index__].Length" type="number" step="0.001" min="0.001" value="" aria-label="長 cm" /></td><td><input name="Cargo[__index__].Width" type="number" step="0.001" min="0.001" value="" aria-label="寬 cm" /></td><td><input name="Cargo[__index__].Height" type="number" step="0.001" min="0.001" value="" aria-label="高 cm" /></td><td><input name="Cargo[__index__].Weight" type="number" step="0.001" min="0" value="" aria-label="重量 kg" /></td><td><input name="Cargo[__index__].Quantity" type="number" step="1" min="1" value="1" aria-label="件數" /></td><td><select name="Cargo[__index__].Category"><option value="">請選擇</option>@foreach (var option in Model.Options.Where(x => x.Type == "CARGO_CATEGORY")) { <option value="@option.Code">@option.Label</option> }</select></td><td><input name="Cargo[__index__].Packaging" type="text" maxlength="200" aria-label="外包裝" /></td><td><input name="Cargo[__index__].Hazardous" type="checkbox" value="true" /><input name="Cargo[__index__].Hazardous" type="hidden" value="false" /></td><td><button type="button" data-remove>刪除</button></td></tr></template>

